; Harness Allocator — app-config template.
; Copy into place next to the project root:
;   cp harness-allocator.ini.example harness-allocator.ini
; The ini is optional — environment variables override every value and
; cover the defaults (see harness_allocator/config.py).

[harness]
; Codex CLI launcher.
; codex_bin = codex

; Codex working root (-C). Empty = use the caller's cwd (no -C flag).
; codex_workdir =

; Codex additional writable directories (--add-dir), colon/comma-separated.
; Empty = no extra directories.
; codex_add_dirs =

; Codex sandbox mode (--sandbox). Default: workspace-write.
; codex_sandbox = workspace-write

; Codex approval policy (--ask-for-approval). Default: never (autonomous).
; codex_ask_for_approval = never

; Codex fresh-context policy at a governed work-unit boundary. Default: off.
; Supported values: off (existing context) or work_unit (stop + relaunch).
codex_fresh_context_policy = off

; DeepSeek Harness launcher (default: npx @deepseek-ai/dsh).
; dsh_bin = npx @deepseek-ai/dsh

; DeepSeek Harness profile (default: headless — the verified one-shot profile).
; dsh_profile = headless

; Path to the DeepSeek Harness patch overlay that pins the V4 Pro model pair.
; Empty means the harness runs with its own default model config.
; dsh_v4_pro_patch =

; Codex MCP server list (name=url pairs, comma-separated). Empty = MCP off.
; codex_mcp_servers =

; Whether Codex MCP is required. true = fail clearly when servers absent or
; unreachable (GOAL.md §4.2 / TG5). Empty / false = MCP optional.
; codex_mcp_required =

; DeepSeek Harness MCP server list (name=transport=url_or_cmd triples,
; comma-separated). transport must be streamable-http or stdio. Empty = MCP off.
; dsh_mcp_servers =

; Whether DSH MCP is required. true = the plugin's failOnStartupError is set
; and Harness Allocator's validator raises on unreachable servers (TG5).
; Empty / false = MCP optional.
; dsh_mcp_required =

; ── Lease workspace write concurrency ─────────────────────────────────
; lease_conflict = REJECT    ; REJECT or WAIT (default: REJECT)
; lease_wait_timeout = 30.0  ; seconds to wait when lease_conflict=WAIT

; ── Simple-Harness (Run 1010 / Objective A) ────────────────────────────
; Simple-harness is the NINTH SUPPORTED harness — headless one-shot via
; ``simple-harness run --base-url <url> --model <model>
; --workspace <dir> --permission <mode> --output jsonl
; --prompt-file <file> [--max-turns N]``.
;
; The quickstart layout clones simple-harness as a SIBLING of this repo,
; so the wrapper resolves relative to the directory harness-allocator is
; launched from (the repo root). Comment the line out if the wrapper is
; on PATH instead; the built-in default is ``simple-harness``.
simple_harness_bin = ../simple-harness/bin/simple-harness
; simple_harness_base_url =
; simple_harness_api_key_env =
; simple_harness_max_turns = 8
; simple_harness_workdir =

[simple-harness]
; Permission mode emitted as --permission on a simple-harness LAUNCH.
; One of: read_only | workspace_write | full_access.
; Default read_only — the harness's own default (SCOPE §12: never silent
; escalation). An unknown value is REFUSED, never downgraded.
;
; A resident role pane that must create files needs workspace_write; an
; implementer under read_only cannot execute a handoff at all. This key is
; machine-wide — it reaches every simple-harness role on the host. Scope it
; to one role instead by setting SIMPLE_HARNESS_PERMISSION in that role's
; launch environment; the env var overrides this value.
; permission = read_only
; Model request timeout (Go duration: "300s", "5m"). Default 300s.
; The harness's OWN default is 30s — a chat default, and a hard ceiling on a
; single model round trip. An agentic role generating a document exceeds it:
; measured, a role read its contracts, began composing, and was cancelled at
; exactly 30.001s with INTERRUPTED and exit 6.
; request_timeout = 300s
