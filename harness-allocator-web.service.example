# Harness Allocator web UI (port 9142) — read-only browse frontend.
#
# This is a template: %h expands to the invoking user's home directory,
# so it works unmodified when the repo is cloned to ~/harness-allocator.
#
# A USER unit, installed to ~/.config/systemd/user/ (the mcp-light pattern:
# no root, the server runs as the owning user and binds a high port).
#
# The server binds loopback by default because the UI has no auth. If you
# need to reach it from other machines, add
#   Environment=HARNESS_WEB_HOST=0.0.0.0
# to [Service] — that line IS the auth boundary decision, and it exposes
# an unauthenticated UI to your network, so make it deliberately.
#
# Install:
#   cp harness-allocator-web.service.example ~/.config/systemd/user/harness-allocator-web.service
#   systemctl --user daemon-reload
#   systemctl --user enable --now harness-allocator-web
#   loginctl enable-linger $USER      # start at boot without logging in

[Unit]
Description=Harness Allocator web UI (port 9142)
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/harness-allocator
# System python3.12: fastapi/uvicorn are installed system-wide, and the
# package itself is stdlib-only, importable straight from the working
# directory — no venv exists or is needed in this repo.
ExecStart=/usr/bin/python3.12 -m harness_allocator.web

Restart=always
RestartSec=5

NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=default.target
